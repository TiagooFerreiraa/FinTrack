<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <style>
        body { background: #0f172a; color: #e5e7eb; }
        .nav-link:hover { background: rgba(34,197,94,.12); }
        .summary-card { background: rgba(15, 23, 42, 0.8); border: 1px solid rgba(148, 163, 184, 0.2); }
        .category-card { transition: transform .2s ease, border-color .2s ease; }
        .category-card:hover { transform: translateY(-2px); border-color: rgba(34,197,94,.5) !important; }
        .category-card.hidden { display: none !important; }
    </style>
</head>
<body class="bg-dark text-light">
    <div class="container-fluid">
        <div class="row">
            <aside class="col-md-3 col-lg-2 bg-black p-3 border-end border-secondary-subtle min-vh-100">
                <div class="fw-bold fs-3 mb-4">FinTrack</div>
                <nav class="nav flex-column gap-2">
                    <a class="nav-link text-light rounded" href="/dashboard">Dashboard</a>
                    <a class="nav-link text-light rounded" href="/accounts">Contas</a>
                    <a class="nav-link text-light rounded" href="/transactions">Transações</a>
                    <a class="nav-link text-light rounded active bg-success bg-opacity-10" href="/categories">Categorias</a>
                    <a class="nav-link text-light rounded" href="/budgets">Orçamentos</a>
                    <form action="/logout" method="POST" class="mt-3">
                        <button type="submit" class="btn btn-outline-light w-100">Sair</button>
                    </form>
                </nav>
            </aside>

            <main class="col-md-9 col-lg-10 p-4 p-lg-5">
                <div class="d-flex justify-content-between align-items-center mb-4 gap-3 flex-wrap">
                    <div>
                        <p class="text-secondary mb-1">Gestão</p>
                        <h1 class="h2 mb-0">Categorias</h1>
                    </div>
                    <a href="/categories/new" class="btn btn-success">+ Nova categoria</a>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="summary-card rounded-4 p-3 h-100">
                            <div class="text-secondary small text-uppercase">Total</div>
                            <div class="fs-3 fw-bold mt-2"><%= stats.total_categories || 0 %></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="summary-card rounded-4 p-3 h-100">
                            <div class="text-secondary small text-uppercase">Receitas</div>
                            <div class="fs-3 fw-bold mt-2 text-success"><%= stats.receitas || 0 %></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="summary-card rounded-4 p-3 h-100">
                            <div class="text-secondary small text-uppercase">Despesas</div>
                            <div class="fs-3 fw-bold mt-2 text-danger"><%= stats.despesas || 0 %></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="summary-card rounded-4 p-3 h-100">
                            <div class="text-secondary small text-uppercase">Pessoais</div>
                            <div class="fs-3 fw-bold mt-2"><%= stats.personal_categories || 0 %></div>
                        </div>
                    </div>
                </div>

                <div class="card text-bg-dark border border-secondary-subtle rounded-4 mb-4">
                    <div class="card-body">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-6">
                                <input id="categorySearch" type="search" class="form-control bg-dark text-light border-secondary" placeholder="Procurar categoria...">
                            </div>
                            <div class="col-md-6">
                                <div class="btn-group w-100" role="group" aria-label="Filtros de categorias">
                                    <button type="button" class="btn btn-outline-light active filter-btn" data-filter="all">Todas</button>
                                    <button type="button" class="btn btn-outline-light filter-btn" data-filter="receita">Receitas</button>
                                    <button type="button" class="btn btn-outline-light filter-btn" data-filter="despesa">Despesas</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <% if (categories.length === 0) { %>
                    <div class="alert alert-secondary text-dark">Ainda não tens categorias criadas. Cria a primeira para começar a organizar os teus movimentos.</div>
                <% } else { %>
                    <div class="row g-3" id="categoryGrid">
                        <% categories.forEach(category => { %>
                            <div class="col-md-6 col-xl-4 category-card" data-name="<%= category.name.toLowerCase() %>" data-type="<%= category.type %>" data-user="<%= category.user_id ? 'personal' : 'system' %>">
                                <div class="card text-bg-dark border border-secondary-subtle h-100">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                            <div class="d-flex align-items-center gap-3">
                                                <span class="rounded-circle d-inline-flex align-items-center justify-content-center text-dark fw-bold" style="width: 42px; height: 42px; background: <%= category.color || '#22c55e' %>;">
                                                    <%= category.icon || '•' %>
                                                </span>
                                                <div>
                                                    <h5 class="mb-0"><%= category.name %></h5>
                                                    <small class="text-secondary"><%= category.type %></small>
                                                </div>
                                            </div>
                                            <% if (category.user_id) { %>
                                                <span class="badge text-bg-light text-dark">Pessoal</span>
                                            <% } else { %>
                                                <span class="badge text-bg-secondary">Sistema</span>
                                            <% } %>
                                        </div>

                                        <div class="d-flex gap-2 mt-3 flex-wrap">
                                            <a href="/categories/<%= category.id %>/edit" class="btn btn-outline-light btn-sm">Editar</a>
                                            <% if (category.user_id) { %>
                                                <form action="/categories/<%= category.id %>/delete" method="POST" class="d-inline">
                                                    <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Eliminar categoria?');">Eliminar</button>
                                                </form>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </main>
        </div>
    </div>

    <script>
        const searchInput = document.getElementById('categorySearch');
        const cards = Array.from(document.querySelectorAll('.category-card'));
        const filterButtons = Array.from(document.querySelectorAll('.filter-btn'));

        let activeFilter = 'all';

        function renderCards() {
            const query = (searchInput?.value || '').trim().toLowerCase();

            cards.forEach((card) => {
                const matchesText = !query || card.dataset.name.includes(query);
                const matchesFilter = activeFilter === 'all' || card.dataset.type === activeFilter;
                card.classList.toggle('hidden', !(matchesText && matchesFilter));
            });
        }

        searchInput?.addEventListener('input', renderCards);

        filterButtons.forEach((button) => {
            button.addEventListener('click', () => {
                activeFilter = button.dataset.filter;
                filterButtons.forEach((item) => item.classList.toggle('active', item === button));
                renderCards();
            });
        });
    </script>
</body>
</html>
