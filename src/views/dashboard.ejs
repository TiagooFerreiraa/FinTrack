<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <style>
        body { background: #0f172a; color: #e5e7eb; }
        .sidebar { background: #111827; min-height: 100vh; }
        .nav-link { color: #e5e7eb; border-radius: .75rem; }
        .nav-link:hover { background: rgba(34,197,94,.12); color: #fff; }
        .card-soft { background: rgba(17,24,39,.9); border: 1px solid rgba(148,163,184,.15); }
        .table-soft { background: rgba(17,24,39,.9); }
        .badge-receita { background: rgba(34,197,94,.12); color: #86efac; }
        .badge-despesa { background: rgba(239,68,68,.12); color: #fca5a5; }
        .badge-transferencia { background: rgba(59,130,246,.12); color: #bfdbfe; }
        .budget-bar { height: 10px; border-radius: 999px; overflow: hidden; }
        .budget-bar .progress-bar { border-radius: 999px; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <aside class="col-md-3 col-lg-2 sidebar p-3 border-end border-secondary-subtle">
                <div class="fw-bold fs-3 mb-4">FinTrack</div>
                <nav class="nav flex-column gap-2">
                    <a class="nav-link active bg-success bg-opacity-10" href="/dashboard">Dashboard</a>
                    <a class="nav-link" href="/accounts">Contas</a>
                    <a class="nav-link" href="/transactions">Transações</a>
                    <a class="nav-link" href="/categories">Categorias</a>
                    <a class="nav-link" href="/budgets">Orçamentos</a>
                    <form action="/logout" method="POST" class="mt-3">
                        <button type="submit" class="btn btn-outline-light w-100">Sair</button>
                    </form>
                </nav>
            </aside>

            <main class="col-md-9 col-lg-10 p-4 p-lg-5">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                    <div>
                        <div class="text-secondary">Bem-vindo</div>
                        <h1 class="h2 mb-0"><%= user.name %></h1>
                    </div>
                    <div class="text-end">
                        <div class="small text-secondary">Mês atual</div>
                        <div class="fw-semibold"><%= month %>/<%= year %></div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-3">
                        <div class="card-soft rounded-4 p-4 h-100">
                            <div class="text-secondary text-uppercase small">Saldo total</div>
                            <div class="fs-2 fw-bold mt-2"><%= formatCurrency(totalBalance) %></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card-soft rounded-4 p-4 h-100">
                            <div class="text-secondary text-uppercase small">Receitas</div>
                            <div class="fs-2 fw-bold text-success mt-2"><%= formatCurrency(monthlySummary.month_income) %></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card-soft rounded-4 p-4 h-100">
                            <div class="text-secondary text-uppercase small">Despesas</div>
                            <div class="fs-2 fw-bold text-danger mt-2"><%= formatCurrency(monthlySummary.month_expenses) %></div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card-soft rounded-4 p-4 h-100">
                            <div class="text-secondary text-uppercase small">Saldo do mês</div>
                            <div class="fs-2 fw-bold mt-2 <%= monthlySummary.month_balance >= 0 ? 'text-success' : 'text-danger' %>"><%= formatCurrency(monthlySummary.month_balance) %></div>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-lg-8">
                        <div class="card-soft rounded-4 p-4 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 class="h5 mb-0">Orçamentos do mês</h2>
                                <a href="/budgets" class="btn btn-sm btn-outline-light">Ver todos</a>
                            </div>

                            <% if (budgetStatus.length === 0) { %>
                                <div class="text-secondary">Ainda não tens orçamentos definidos para este mês.</div>
                            <% } else { %>
                                <% budgetStatus.forEach(budget => { %>
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <div class="fw-semibold"><%= budget.category_name %></div>
                                            <div class="small <%= budget.alert ? 'text-warning' : 'text-secondary' %>"><%= formatCurrency(budget.spent) %> / <%= formatCurrency(budget.amount_limit) %></div>
                                        </div>
                                        <div class="budget-bar bg-secondary-subtle">
                                            <div class="progress-bar h-100 <%= budget.alert ? 'bg-warning' : 'bg-success' %>" style="width: <%= Math.min(budget.percent, 100) %>%"></div>
                                        </div>
                                        <div class="small text-secondary mt-1">
                                            Restante: <span class="<%= budget.remaining < 0 ? 'text-danger' : 'text-light' %>"><%= formatCurrency(budget.remaining) %></span>
                                        </div>
                                    </div>
                                <% }); %>
                            <% } %>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card-soft rounded-4 p-4 h-100">
                            <h2 class="h5 mb-3">Top despesas</h2>
                            <% if (categorySpendRows.length === 0) { %>
                                <div class="text-secondary">Ainda não há despesas neste mês.</div>
                            <% } else { %>
                                <% categorySpendRows.forEach((item, index) => { %>
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="rounded-circle d-inline-block" style="width: 12px; height: 12px; background: <%= item.color || '#22c55e' %>;"></span>
                                            <span><%= index + 1 %>. <%= item.name %></span>
                                        </div>
                                        <strong><%= formatCurrency(item.total) %></strong>
                                    </div>
                                <% }); %>
                            <% } %>
                        </div>
                    </div>
                </div>

                <div class="card-soft rounded-4 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-dark table-striped table-hover align-middle mb-0 table-soft">
                            <thead>
                                <tr>
                                    <th>Data</th>
                                    <th>Tipo</th>
                                    <th>Descrição</th>
                                    <th>Conta</th>
                                    <th>Valor</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentTransactions.forEach(tx => { %>
                                    <tr>
                                        <td><%= new Date(tx.transaction_date).toLocaleDateString('pt-PT') %></td>
                                        <td>
                                            <span class="badge rounded-pill badge-<%= tx.type %>"><%= tx.type %></span>
                                        </td>
                                        <td><%= tx.description || 'Sem descrição' %></td>
                                        <td><%= tx.account_name || 'N/A' %></td>
                                        <td class="fw-semibold <%= tx.type === 'despesa' ? 'text-danger' : 'text-success' %>">
                                            <%= tx.type === 'despesa' ? '-' : '' %><%= formatCurrency(tx.amount) %>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
