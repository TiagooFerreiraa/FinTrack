<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body { margin: 0; font-family: Arial, sans-serif; background: #0f172a; color: #e5e7eb; }
        .layout { display: grid; grid-template-columns: 220px 1fr; min-height: 100vh; }
        .sidebar { background: #111827; padding: 24px 18px; border-right: 1px solid rgba(148,163,184,0.2); }
        .brand { font-size: 1.6rem; font-weight: 700; margin-bottom: 24px; }
        .nav a, .nav form button { display: block; width: 100%; text-align: left; padding: 12px 14px; border-radius: 10px; color: #e5e7eb; text-decoration: none; background: transparent; border: none; cursor: pointer; margin-bottom: 6px; }
        .nav a:hover, .nav form button:hover { background: rgba(34,197,94,0.12); }
        .main { padding: 28px; }
        .card { max-width: 700px; background: rgba(17,24,39,0.9); border: 1px solid rgba(148,163,184,0.16); border-radius: 18px; padding: 24px; }
        h1 { margin-top: 0; }
        label { display: block; margin-bottom: 8px; color: #cbd5e1; }
        input, select { width: 100%; background: #0b1220; color: #fff; border: 1px solid rgba(148,163,184,0.2); border-radius: 10px; padding: 12px 14px; margin-bottom: 18px; }
        .btn { display: inline-block; background: #22c55e; color: #062d12; font-weight: 700; text-decoration: none; border: none; border-radius: 10px; padding: 12px 18px; cursor: pointer; }
        .alert { background: rgba(239,68,68,0.12); color: #fecaca; border: 1px solid rgba(239,68,68,0.4); border-radius: 10px; padding: 12px 14px; margin-bottom: 18px; }
        .row { display: flex; gap: 12px; }
        .muted { color: #94a3b8; }
    </style>
</head>
<body>
    <div class="layout">
        <aside class="sidebar">
            <div class="brand">FinTrack</div>
            <nav class="nav">
                <a href="/dashboard">Dashboard</a>
                <a href="/accounts">Contas</a>
                <a href="/transactions">Transações</a>
                <form action="/logout" method="POST">
                    <button type="submit">Sair</button>
                </form>
            </nav>
        </aside>

        <main class="main">
            <div class="card">
                <h1><%= title %></h1>

                <% if (error) { %>
                    <div class="alert"><%= error %></div>
                <% } %>

                <form method="POST" action="<%= account && account.id ? '/accounts/' + account.id + '/edit' : '/accounts/new' %>">
                    <label for="name">Nome da conta</label>
                    <input id="name" name="name" type="text" value="<%= account ? account.name || '' : '' %>" required>

                    <label for="type">Tipo</label>
                    <select id="type" name="type">
                        <option value="corrente" <%= account && account.type === 'corrente' ? 'selected' : '' %>>Corrente</option>
                        <option value="poupanca" <%= account && account.type === 'poupanca' ? 'selected' : '' %>>Poupança</option>
                        <option value="cartao_credito" <%= account && account.type === 'cartao_credito' ? 'selected' : '' %>>Cartão de crédito</option>
                        <option value="dinheiro" <%= account && account.type === 'dinheiro' ? 'selected' : '' %>>Dinheiro</option>
                        <option value="investimento" <%= account && account.type === 'investimento' ? 'selected' : '' %>>Investimento</option>
                    </select>

                    <label for="currency">Moeda</label>
                    <select id="currency" name="currency">
                        <option value="EUR" <%= account && account.currency === 'EUR' ? 'selected' : '' %>>EUR</option>
                        <option value="USD" <%= account && account.currency === 'USD' ? 'selected' : '' %>>USD</option>
                        <option value="GBP" <%= account && account.currency === 'GBP' ? 'selected' : '' %>>GBP</option>
                    </select>

                    <% if (!account || !account.id) { %>
                        <label for="initial_balance">Saldo inicial</label>
                        <input id="initial_balance" name="initial_balance" type="number" step="0.01" value="0.00">
                    <% } %>

                    <div class="row">
                        <button class="btn" type="submit">Guardar</button>
                        <a class="btn" href="/accounts" style="background:#1f2937;color:#e5e7eb;border:1px solid rgba(148,163,184,0.2);">Cancelar</a>
                    </div>
                </form>
            </div>
        </main>
    </div>
</body>
</html>
