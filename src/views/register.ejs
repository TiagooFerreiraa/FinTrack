<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    <style>
        body { background: linear-gradient(135deg, #0b1220, #111827 60%, #0f172a); color: #e5e7eb; min-height: 100vh; }
        .auth-card { background: rgba(17, 24, 39, 0.88); border: 1px solid rgba(148,163,184,.2); border-radius: 1rem; box-shadow: 0 1rem 3rem rgba(0,0,0,.35); }
        .form-control, .form-control:focus { background: #0b1220; color: #fff; border-color: rgba(148,163,184,.25); }
        .alert { border-radius: .75rem; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="auth-card p-4 p-md-5">
                    <h1 class="h2 text-center mb-2">Criar conta</h1>
                    <p class="text-secondary text-center mb-4">Começa a tua jornada financeira</p>

                    <% if (error) { %>
                        <div class="alert alert-danger"><%= error %></div>
                    <% } %>

                    <form method="POST" action="/register">
                        <div class="mb-3">
                            <label for="name" class="form-label">Nome</label>
                            <input id="name" name="name" type="text" class="form-control" value="<%= formData.name || '' %>" required>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input id="email" name="email" type="email" class="form-control" value="<%= formData.email || '' %>" required>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">Palavra-passe</label>
                            <input id="password" name="password" type="password" class="form-control" minlength="8" required>
                        </div>

                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">Confirmar palavra-passe</label>
                            <input id="confirmPassword" name="confirmPassword" type="password" class="form-control" minlength="8" required>
                        </div>

                        <button type="submit" class="btn btn-success w-100 fw-semibold">Criar conta</button>
                    </form>

                    <p class="text-center mt-4 mb-0 text-secondary">
                        Já tens conta? <a href="/login" class="text-success text-decoration-none">Entrar</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
