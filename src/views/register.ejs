<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #0f172a;
            color: #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .auth-card {
            background: rgba(17, 24, 39, 0.9);
            border: 1px solid rgba(148, 163, 184, 0.2);
            border-radius: 18px;
            width: min(92vw, 440px);
            padding: 32px 28px;
            box-shadow: 0 18px 50px rgba(0, 0, 0, 0.25);
        }

        h1 {
            margin: 0 0 8px;
            font-size: 2rem;
            text-align: center;
        }

        p {
            margin: 0 0 24px;
            color: #94a3b8;
            text-align: center;
        }

        .alert {
            background: rgba(239, 68, 68, 0.12);
            color: #fecaca;
            border: 1px solid rgba(239, 68, 68, 0.4);
            border-radius: 10px;
            padding: 12px 14px;
            margin-bottom: 16px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.9rem;
            color: #cbd5e1;
        }

        input {
            width: 100%;
            border: 1px solid rgba(148, 163, 184, 0.25);
            border-radius: 10px;
            background: #0b1220;
            color: #fff;
            padding: 12px 14px;
            margin-bottom: 18px;
            font-size: 1rem;
        }

        button {
            width: 100%;
            border: none;
            border-radius: 10px;
            background: #22c55e;
            color: #062d12;
            font-weight: 700;
            padding: 13px 16px;
            cursor: pointer;
            font-size: 1rem;
        }

        .bottom-link {
            text-align: center;
            margin-top: 18px;
            color: #cbd5e1;
        }

        .bottom-link a {
            color: #86efac;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <h1>Criar conta</h1>
        <p>Começa a tua jornada financeira</p>

        <% if (error) { %>
            <div class="alert"><%= error %></div>
        <% } %>

        <form method="POST" action="/register">
            <label for="name">Nome Completo</label>
            <input id="name" name="name" type="text" value="<%= formData.name || '' %>" required>

            <label for="email">Email</label>
            <input id="email" name="email" type="email" value="<%= formData.email || '' %>" required>

            <label for="password">Palavra-passe</label>
            <input id="password" name="password" type="password" minlength="8" required>

            <label for="confirmPassword">Confirmar palavra-passe</label>
            <input id="confirmPassword" name="confirmPassword" type="password" minlength="8" required>

            <button type="submit">Criar conta</button>
        </form>

        <div class="bottom-link">
            Já tens conta? <a href="/login">Entrar</a>
        </div>
    </div>
</body>
</html>
