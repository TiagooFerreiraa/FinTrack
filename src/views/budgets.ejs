<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body class="bg-dark text-light">
    <div class="container-fluid">
        <div class="row">
            <aside class="col-md-3 col-lg-2 bg-black p-3 border-end border-secondary-subtle min-vh-100">
                <div class="fw-bold fs-3 mb-4">FinTrack</div>
                <nav class="nav flex-column gap-2">
                    <a class="nav-link text-light rounded" href="/dashboard">Dashboard</a>
                    <a class="nav-link text-light rounded" href="/accounts">Contas</a>
                    <a class="nav-link text-light rounded" href="/transactions">Transações</a>
                    <a class="nav-link text-light rounded" href="/categories">Categorias</a>
                    <a class="nav-link text-light rounded" href="/budgets">Orçamentos</a>
                    <form action="/logout" method="POST" class="mt-3">
                        <button type="submit" class="btn btn-outline-light w-100">Sair</button>
                    </form>
                </nav>
            </aside>

            <main class="col-md-9 col-lg-10 p-4 p-lg-5">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <p class="text-secondary mb-1">Orçamentos</p>
                        <h1 class="h2 mb-0"><%= month %>/<%= year %></h1>
                    </div>
                    <a href="/budgets/new" class="btn btn-success">+ Novo orçamento</a>
                </div>

                <% if (budgets.length === 0) { %>
                    <div class="alert alert-secondary text-dark">Ainda não tens orçamentos para este mês.</div>
                <% } else { %>
                    <div class="row g-3">
                        <% budgets.forEach(budget => { %>
                            <div class="col-lg-6">
                                <div class="card text-bg-dark border border-secondary-subtle rounded-4 h-100">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <div>
                                                <div class="small text-secondary text-uppercase">Categoria</div>
                                                <h5 class="mb-0"><%= budget.category_name %></h5>
                                            </div>
                                            <span class="badge rounded-pill" style="background:<%= budget.color || '#22c55e' %>; color:#07131c;"><%= budget.category_type %></span>
                                        </div>

                                        <div class="mb-2">
                                            <small class="text-secondary">Limite</small>
                                            <div class="fs-4 fw-bold"><%= formatCurrency(budget.amount_limit) %></div>
                                        </div>

                                        <div class="mb-2">
                                            <small class="text-secondary">Gasto</small>
                                            <div class="fs-5"><%= formatCurrency(budget.spent) %></div>
                                        </div>

                                        <div class="progress mb-3" style="height: 12px;">
                                            <div class="progress-bar bg-success" role="progressbar" style="width: <%= Math.min((budget.spent / budget.amount_limit) * 100, 100) %>%"></div>
                                        </div>

                                        <div class="d-flex justify-content-between text-secondary small">
                                            <span>Restante</span>
                                            <span class="text-light"><%= formatCurrency(budget.remaining) %></span>
                                        </div>

                                        <form action="/budgets/<%= budget.id %>/delete" method="POST" class="mt-3">
                                            <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Eliminar orçamento?');">Eliminar</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </main>
        </div>
    </div>
</body>
</html>
