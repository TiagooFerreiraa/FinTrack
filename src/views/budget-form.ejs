<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body class="bg-dark text-light">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card text-bg-dark border border-secondary-subtle rounded-4 shadow">
                    <div class="card-body p-4 p-md-5">
                        <h1 class="h2 mb-4"><%= title %></h1>

                        <% if (typeof error !== 'undefined' && error) { %>
                            <div class="alert alert-danger"><%= error %></div>
                        <% } %>

                        <form method="POST" action="/budgets/new">
                            <div class="mb-3">
                                <label for="category_id" class="form-label">Categoria</label>
                                <select id="category_id" name="category_id" class="form-select bg-dark text-light border-secondary" required>
                                    <option value="">Seleciona uma categoria</option>
                                    <% categories.forEach(category => { %>
                                        <option value="<%= category.id %>" <%= budget && budget.category_id == category.id ? 'selected' : '' %>><%= category.name %></option>
                                    <% }); %>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="amount_limit" class="form-label">Limite (€)</label>
                                <input id="amount_limit" name="amount_limit" type="number" min="0.01" step="0.01" class="form-control bg-dark text-light border-secondary" value="<%= budget && budget.amount_limit ? budget.amount_limit : '' %>" required>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="period_month" class="form-label">Mês</label>
                                    <select id="period_month" name="period_month" class="form-select bg-dark text-light border-secondary">
                                        <% for (let m = 1; m <= 12; m++) { %>
                                            <option value="<%= m %>" <%= (budget && budget.period_month == m) || (!budget && m == new Date().getMonth()+1) ? 'selected' : '' %>><%= m %></option>
                                        <% } %>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label for="period_year" class="form-label">Ano</label>
                                    <input id="period_year" name="period_year" type="number" min="2024" class="form-control bg-dark text-light border-secondary" value="<%= budget && budget.period_year ? budget.period_year : new Date().getFullYear() %>">
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-4">
                                <button type="submit" class="btn btn-success">Guardar</button>
                                <a href="/budgets" class="btn btn-outline-light">Cancelar</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
